# Environment Variables — Backend Portfolio Fajrin
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=portfolio_fajrin

PORT=5000
NODE_ENV=development

# Untuk produksi, ganti NODE_ENV=production
# dan pertimbangkan untuk disable endpoint write di /manage
